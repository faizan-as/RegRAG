# ==========================================================
# FDA Regulatory Intelligence Platform - Environment Template
# Copy to .env and fill in real values. Never commit .env.
# ==========================================================

# ---- Application ----
APP_ENV=development                 # development | staging | pilot
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Vector (pgvector) & Keyword Search ----
# Dense vectors are stored in PostgreSQL via pgvector (see DATABASE_URL below).
PGVECTOR_TABLE=guidance_chunks
EMBEDDING_DIM=1024
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX=fda_guidance

# ---- LLM Configuration (Azure OpenAI primary) ----
LLM_PROVIDER=azure_openai           # azure_openai | anthropic | vllm
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
LLM_CHOICE=gpt-4.1

# Fallback providers (optional)
ANTHROPIC_API_KEY=
ONPREM_LLM_BASE_URL=http://localhost:8001/v1   # vLLM (Llama 3.3 / Qwen)

# ---- Embeddings & Reranking ----
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large

# ---- Ingestion ----
FDA_GUIDANCE_JSON_URL=https://www.fda.gov/files/api/datatables/static/search-for-guidance.json
FDA_BASE_URL=https://www.fda.gov
PARENT_CHUNK_SIZE=8000
CHILD_CHUNK_SIZE=1200
CHILD_CHUNK_OVERLAP=150
EMBED_BATCH_SIZE=32
INGEST_SCHEDULE_CRON="0 2 * * *"

# ---- Metadata DB (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://fda:fda@localhost:5432/fda_copilot

# ---- Artifact Storage ----
OBJECT_STORE_BACKEND=local
OBJECT_STORE_BASE_PATH=data/object_store

# ---- Auth (Supabase) ----
SUPABASE_URL=
SUPABASE_KEY=

# ---- Observability (Langfuse) ----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Retrieval tuning ----
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
CONFIDENCE_THRESHOLD=0.5
MAX_FAITHFULNESS_RETRIES=1
